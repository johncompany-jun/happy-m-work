  RewriteRule ^blog/kpop1ptu3/?$     /blog/gni6zt10mb/  [R=301,L]
  RewriteRule ^blog/zdtgke5m_-r/?$   /blog/gni6zt10mb/  [R=301,L]

  # =============================================================
  #  Dockerクラスタ統合(2026-10-08・5h8pglq99zへ集約)
  # =============================================================
  # Docker Compose / Laravel Sail → 柱記事(Docker完全ガイド)へ
  RewriteRule ^blog/2t2udyn-dflk/?$  /blog/5h8pglq99z/  [R=301,L]
  RewriteRule ^blog/53gbgjnwof/?$    /blog/5h8pglq99z/  [R=301,L]

  # =============================================================
  #  API/認証クラスタ統合(2026-10-08・pxhbtzmvqwwgへ集約)
  # =============================================================
  # OAuth / REST vs GraphQL → 柱記事(API設計・認証完全ガイド)へ
  RewriteRule ^blog/fh_mdk6qx/?$     /blog/pxhbtzmvqwwg/  [R=301,L]
  RewriteRule ^blog/90shzfs36/?$     /blog/pxhbtzmvqwwg/  [R=301,L]

  # =============================================================
  #  独学・モチベーション・NG習慣クラスタ統合(2026-10-08・programming-self-study-guide-2026へ集約)
  # =============================================================
  # モチベ維持 / NG習慣 → 柱記事(独学挫折回避完全ガイド)へ
  RewriteRule ^blog/agolki3th/?$     /blog/programming-self-study-guide-2026/  [R=301,L]
  RewriteRule ^blog/8clfvjbdvo/?$    /blog/programming-self-study-guide-2026/  [R=301,L]

  # =============================================================
  #  ピラー5本 旧ランダムID → 意味あるスラッグへ改名(2026-10-13)
  #  未インデックス改善+LLMO/SEO強化のためスラッグ化
  #  ⚠ microCMS管理画面でContent IDを下記新スラッグに変更する作業と対応
  # =============================================================
  RewriteRule ^blog/22ivt5mg3hl8/?$  /blog/server-guide-for-side-business-2026/  [R=301,L]
  RewriteRule ^blog/c-ux14j-gk/?$    /blog/programming-language-guide-2026/      [R=301,L]
  RewriteRule ^blog/x4c-rbisf1/?$    /blog/engineer-learning-resources-2026/     [R=301,L]
  RewriteRule ^blog/6ifrokml19dd/?$  /blog/programming-self-study-guide-2026/    [R=301,L]
  RewriteRule ^blog/2ol4bn8dpl/?$    /blog/web-engineer-roadmap-2026/            [R=301,L]

  # =============================================================
  #  LOW記事8本 削除・統合(2026-10-13)
  #  2本は本文をpillarに統合済、6本は方向性合致せず削除
  # =============================================================
  # 統合2本(本文転記済) → 統合先pillarへ
  RewriteRule ^blog/mg7cpvj_yqgb/?$  /blog/programming-language-guide-2026/      [R=301,L]
  RewriteRule ^blog/5a45x6x6xo/?$    /blog/server-guide-for-side-business-2026/  [R=301,L]
  # 削除6本 → 方向性に沿った近縁pillarへ
  RewriteRule ^blog/wl-2h_gt_tl/?$   /blog/programming-language-guide-2026/      [R=301,L]
  RewriteRule ^blog/ozr41rhdrl5/?$   /blog/programming-self-study-guide-2026/    [R=301,L]
