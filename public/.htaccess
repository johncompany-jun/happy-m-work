  # =============================================================
  # YouTube/無料教材 → 柱記事(エンジニア学習リソース完全ガイド)へ
  RewriteRule ^blog/l9yoatt48/?$     /blog/engineer-learning-resources-2026/  [R=301,L]
  RewriteRule ^blog/z176w6h36oj/?$   /blog/engineer-learning-resources-2026/  [R=301,L]

  # =============================================================
