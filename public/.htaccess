# =============================================================
#  301 リダイレクト設定
#  削除・統合した記事 → 統合先記事へ評価を引き継ぐ
#  生成日: 2026-06-03(削除候補7本の統合処理)
#  注意: このサイトが Apache(レンタルサーバー)で動いている前提。
#        nginx の場合は server ブロックに同等の rewrite を記述すること。
# =============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- テレワーク薄記事4本 → 「メリット・デメリット完全ガイド」(sscms7e5w)へ統合 ---
  RewriteRule ^blog/gncbw2c2ahq/?$  /blog/sscms7e5w/  [R=301,L]
  RewriteRule ^blog/s_se4l-9mq1/?$  /blog/sscms7e5w/  [R=301,L]
  RewriteRule ^blog/xvex2wqwbiq/?$  /blog/sscms7e5w/  [R=301,L]
  RewriteRule ^blog/8rfqxx41hk/?$   /blog/sscms7e5w/  [R=301,L]

  # --- モバイルデュアルディスプレイ → 自宅版(29_rgphpu)へ統合 ---
  RewriteRule ^blog/3lyaeae6x7-i/?$ /blog/29_rgphpu/  [R=301,L]

  # =============================================================
  #  カテゴリリネーム: telework → freelance (2026-10-07)
  #  カテゴリページ本体と、画面上に残っているアンカーからのリンクを両方捕捉
  # =============================================================
  # カテゴリ一覧ページ
  RewriteRule ^blog/telework/?$  /blog/freelance/  [R=301,L]

  # 削除5本(物販系・2026-10-07削除分): 近縁な残存記事またはカテゴリ先へ送る
  RewriteRule ^blog/9rlq15k9h/?$     /blog/freelance/  [R=301,L]
  RewriteRule ^blog/8l8dtr-gpad/?$   /blog/freelance/  [R=301,L]
  RewriteRule ^blog/0y8o9cki9/?$     /blog/freelance/  [R=301,L]
  RewriteRule ^blog/w67q2zpceq06/?$  /blog/vdokda6t1p9y/  [R=301,L]
  RewriteRule ^blog/m38wpkrue/?$     /blog/c89m8d_pvbge/  [R=301,L]

  # =============================================================
  #  削除11本(薄い記事・カニバリ・テレワーク色強すぎ・2026-10-08削除分)
  # =============================================================
  # VPN重複2本 → VPN比較記事へ
  RewriteRule ^blog/fgd1dqicgjcd/?$  /blog/c89m8d_pvbge/  [R=301,L]
  RewriteRule ^blog/d7u8g6tnckd/?$   /blog/c89m8d_pvbge/  [R=301,L]
  # コワーキング重複2本 → コワーキング比較記事へ
  RewriteRule ^blog/lnr6r6nyiag/?$   /blog/qwvejtgmx/  [R=301,L]
  RewriteRule ^blog/fod2rgo1-98/?$   /blog/qwvejtgmx/  [R=301,L]
  # タスク管理重複 → PM/タスクツール記事へ
  RewriteRule ^blog/8ij7s2o-wqn/?$   /blog/o-cjvi8_i_d/  [R=301,L]
  # 薄い6本 → フリーランスカテゴリへ
  RewriteRule ^blog/exwsj2f5b/?$     /blog/freelance/  [R=301,L]
  RewriteRule ^blog/c9oxt6bwfu39/?$  /blog/freelance/  [R=301,L]
  RewriteRule ^blog/l8wi1yg9wdcz/?$  /blog/freelance/  [R=301,L]
  RewriteRule ^blog/0_-72b69_7yj/?$  /blog/freelance/  [R=301,L]
  RewriteRule ^blog/ypocbockas/?$    /blog/freelance/  [R=301,L]
  RewriteRule ^blog/g0xy674ih6/?$    /blog/freelance/  [R=301,L]

  # =============================================================
  #  削除2本(薄い記事・2026-10-08追加削除分)
  # =============================================================
  # 自己管理術 → なり方記事(キャリア文脈)
  RewriteRule ^blog/u_7_ga07es5x/?$  /blog/freelance-engineer-how-to-become-2026/  [R=301,L]
  # 在宅集中力時間術 → ライフハック系残存記事 or カテゴリ
  RewriteRule ^blog/y574q7kpw0ih/?$  /blog/freelance/  [R=301,L]

  # =============================================================
  #  サーバークラスタ統合3本(2026-10-08・server-guide-for-side-business-2026へ集約)
  # =============================================================
  # VPS vs レンタサバ・格安レンタサバ・クラウド導入 → 柱記事(個人開発・副業に最適なサーバー完全ガイド)へ
