  # =============================================================
  # Python vs JavaScript → 柱記事(プログラミング言語選び完全ガイド)へ
  RewriteRule ^blog/a9zf6tbqz7i/?$   /blog/programming-language-guide-2026/  [R=301,L]

  # =============================================================
